Q4:
CODE:
#include <stdio.h>
int main()
{
    float hitRatio, MAT, TLB;
    float withoutTLB, withTLB;
    printf("Enter Memory Access Time: ");
    scanf("%f",&MAT);
    printf("Enter TLB Access Time: ");
    scanf("%f",&TLB);
    printf("Enter Hit Ratio (0-1): ");
    scanf("%f",&hitRatio);

    withoutTLB = 2 * MAT;

    withTLB = hitRatio*(TLB+MAT)
             +(1-hitRatio)*(TLB+2*MAT);

    printf("Memory Access Time without TLB = %.2f ns\n",withoutTLB);
    printf("Effective Memory Access Time with TLB = %.2f ns",withTLB);

    return 0;
}
OUTPUT:
Memory Access Time = 100
TLB Access Time = 10
Hit Ratio = 0.8

Without TLB = 200 ns
With TLB = 130 ns

